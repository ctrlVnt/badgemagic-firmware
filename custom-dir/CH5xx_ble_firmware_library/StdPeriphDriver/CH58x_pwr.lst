 233              	 *
 234              	 * @brief   低功耗-Halt模式，此低功耗切到HSI/5时钟运行，唤醒后需要用户自己重新选择系统时钟源
 235              	 *
 236              	 * @param   none
 237              	 *
 238              	 * @return  none
 239              	 */
 240              	__HIGH_CODE
 241              	void LowPower_Halt(void)
 242              	{
 243              	    uint8_t x32Kpw, x32Mpw;
 244              	
 245              	    FLASH_ROM_SW_RESET();
 246              	    R8_FLASH_CTRL = 0x04; //flash关闭
 247              	    x32Kpw = R8_XT32K_TUNE;
 248              	    x32Mpw = R8_XT32M_TUNE;
 249              	    x32Mpw = (x32Mpw & 0xfc) | 0x03; // 150%额定电流
 250              	    if(R16_RTC_CNT_32K > 0x3fff)
 251              	    {                                    // 超过500ms
 252              	        x32Kpw = (x32Kpw & 0xfc) | 0x01; // LSE驱动电流降低到额定电流
 253              	    }
 254              	
 255              	    sys_safe_access_enable();
 256              	    R8_BAT_DET_CTRL = 0; // 关闭电压监控
 257              	    sys_safe_access_enable();
 258              	    R8_XT32K_TUNE = x32Kpw;
 259              	    R8_XT32M_TUNE = x32Mpw;
 260              	    sys_safe_access_enable();
 261              	    R8_PLL_CONFIG |= (1 << 5);
 262              	    sys_safe_access_disable();
 263              	
 264              	    PFIC->SCTLR |= (1 << 2); //deep sleep
 265              	    __WFI();
 266 00f0 0100     	    __nop();
 267              	    __nop();
 422              		nop
 423              	# 0 "" 2
 424              	# 267 "CH5xx_ble_firmware_library/StdPeriphDriver/CH58x_pwr.c" 1
 268              	    sys_safe_access_enable();
