  15              	/*********************************************************************
  16              	 * @fn      PWR_DCDCCfg
  17              	 *
  18              	 * @brief   启用内部DC/DC电源，用于节约系统功耗
  19              	 *
GAS LISTING /tmp/cc3W7np8.s 			page 16


  20              	 * @param   s       - 是否打开DCDC电源
  21              	 *
  22              	 * @return  none
  23              	 */
  24              	void PWR_DCDCCfg(FunctionalState s)
  25              	{
  26              	    uint16_t adj = R16_AUX_POWER_ADJ;
  27              	    uint16_t plan = R16_POWER_PLAN;
  28              	
  29              	    if(s == DISABLE)
  30              	    {
  31              	        
  32              	        adj &= ~RB_DCDC_CHARGE;
  33              	        plan &= ~(RB_PWR_DCDC_EN | RB_PWR_DCDC_PRE); // 旁路 DC/DC
  34              	        sys_safe_access_enable();
  35              	        R16_AUX_POWER_ADJ = adj;
  36              	        R16_POWER_PLAN = plan;
  37              	        sys_safe_access_disable();
  38              	    }
  39              	    else
  40              	    {
  41              	        adj |= RB_DCDC_CHARGE;
  42              	        plan |= RB_PWR_DCDC_PRE;
  43              	        sys_safe_access_enable();
  44              	        R16_AUX_POWER_ADJ = adj;
  45              	        R16_POWER_PLAN = plan;
  46              	        DelayUs(10);
  47              	        sys_safe_access_enable();
  48              	        R16_POWER_PLAN |= RB_PWR_DCDC_EN;
  49              	        sys_safe_access_disable();
  50              	    }
  51              	}
  52              	
  53              	/*********************************************************************
  54              	 * @fn      PWR_UnitModCfg
  55              	 *
  56              	 * @brief   可控单元模块的电源控制
  57              	 *
  58              	 * @param   s       - 是否打开电源
  59              	 * @param   unit    - please refer to unit of controllable power supply
  60              	 *
  61              	 * @return  none
  62              	 */
  63              	void PWR_UnitModCfg(FunctionalState s, uint8_t unit)
  64              	{
  65              	    uint8_t pwr_ctrl = R8_HFCK_PWR_CTRL;
  66              	    uint8_t ck32k_cfg = R8_CK32K_CONFIG;
  67              	
  68              	    if(s == DISABLE) //关闭
  69              	    {
  70              	        pwr_ctrl &= ~(unit & 0x1c);
  71              	        ck32k_cfg &= ~(unit & 0x03);
  72              	    }
  73              	    else //打开
  74              	    {
  75              	        pwr_ctrl |= (unit & 0x1c);
  76              	        ck32k_cfg |= (unit & 0x03);
GAS LISTING /tmp/cc3W7np8.s 			page 17


  77              	    }
  78              	
  79              	    sys_safe_access_enable();
  80              	    R8_HFCK_PWR_CTRL = pwr_ctrl;
  81              	    R8_CK32K_CONFIG = ck32k_cfg;
  82              	    sys_safe_access_disable();
  83              	}
  84              	
  85              	/*********************************************************************
  86              	 * @fn      PWR_PeriphClkCfg
  87              	 *
  88              	 * @brief   外设时钟控制位
  89              	 *
  90              	 * @param   s       - 是否打开对应外设时钟
  91              	 * @param   perph   - please refer to Peripher CLK control bit define
  92              	 *
  93              	 * @return  none
  94              	 */
  95              	void PWR_PeriphClkCfg(FunctionalState s, uint16_t perph)
  96              	{
  97              	    uint32_t sleep_ctrl = R32_SLEEP_CONTROL;
  98              	
  99              	    if(s == DISABLE)
 100              	    {
 101              	        sleep_ctrl |= perph;
 102              	    }
 103              	    else
 104              	    {
 105              	        sleep_ctrl &= ~perph;
 106              	    }
 107              	
 108              	    sys_safe_access_enable();
 109              	    R32_SLEEP_CONTROL = sleep_ctrl;
 110              	    sys_safe_access_disable();
 111              	}
 112              	
 113              	/*********************************************************************
 114              	 * @fn      PWR_PeriphWakeUpCfg
 115              	 *
 116              	 * @brief   睡眠唤醒源配置
 117              	 *
 118              	 * @param   s       - 是否打开此外设睡眠唤醒功能
 119              	 * @param   perph   - 需要设置的唤醒源
 120              	 *                    RB_SLP_USB_WAKE   -  USB 为唤醒源
 121              	 *                    RB_SLP_RTC_WAKE   -  RTC 为唤醒源
 122              	 *                    RB_SLP_GPIO_WAKE  -  GPIO 为唤醒源
 123              	 *                    RB_SLP_BAT_WAKE   -  BAT 为唤醒源
 124              	 * @param   mode    - refer to WakeUP_ModeypeDef
 125              	 *
 126              	 * @return  none
 127              	 */
 128              	void PWR_PeriphWakeUpCfg(FunctionalState s, uint8_t perph, WakeUP_ModeypeDef mode)
 129              	{
 130              	    uint8_t m;
 131              	
 132              	    if(s == DISABLE)
 133              	    {
GAS LISTING /tmp/cc3W7np8.s 			page 18


 134              	        sys_safe_access_enable();
 135              	        R8_SLP_WAKE_CTRL &= ~perph;
 136              	    }
 137              	    else
 138              	    {
 139              	        switch(mode)
 140              	        {
 141              	            case Short_Delay:
 142              	                m = 0x01;
 143              	                break;
 144              	
 145              	            case Long_Delay:
 146              	                m = 0x00;
 147              	                break;
 148              	
 149              	            default:
 150              	                m = 0x01;
 151              	                break;
 152              	        }
 153              	
 154              	        sys_safe_access_enable();
 155              	        R8_SLP_WAKE_CTRL |= RB_WAKE_EV_MODE | perph;
 156              	        sys_safe_access_enable();
 157              	        R8_SLP_POWER_CTRL &= ~(RB_WAKE_DLY_MOD);
 158              	        sys_safe_access_enable();
 159              	        R8_SLP_POWER_CTRL |= m;
 160              	    }
 161              	    sys_safe_access_disable();
 162              	}
 163              	
 164              	/*********************************************************************
 165              	 * @fn      PowerMonitor
 166              	 *
 167              	 * @brief   电源监控
 168              	 *
 169              	 * @param   s       - 是否打开此功能
 170              	 * @param   vl      - refer to VolM_LevelypeDef
 171              	 *
 172              	 * @return  none
 173              	 */
 174              	void PowerMonitor(FunctionalState s, VolM_LevelypeDef vl)
 175              	{
 176              	    uint8_t ctrl = R8_BAT_DET_CTRL;
 177              	    uint8_t cfg = R8_BAT_DET_CFG;
 178              	
 179              	    if(s == DISABLE)
 180              	    {
 181              	        sys_safe_access_enable();
 182              	        R8_BAT_DET_CTRL = 0;
 183              	        sys_safe_access_disable();
 184              	    }
 185              	    else
 186              	    {
 187              	        if(vl & 0x80)
 188              	        {
 189              	            cfg = vl & 0x03;
 190              	            ctrl = RB_BAT_MON_EN | ((vl >> 2) & 1);
GAS LISTING /tmp/cc3W7np8.s 			page 19


 191              	        }
 192              	        else
 193              	        {
 194              	            
 195              	            cfg = vl & 0x03;
 196              	            ctrl = RB_BAT_DET_EN;
 197              	        }
 198              	        sys_safe_access_enable();
 199              	        R8_BAT_DET_CTRL = ctrl;
 200              	        R8_BAT_DET_CFG = cfg;
 201              	        sys_safe_access_disable();
 202              	
 203              	        mDelayuS(1);
 204              	        sys_safe_access_enable();
 205              	        R8_BAT_DET_CTRL |= RB_BAT_LOW_IE | RB_BAT_LOWER_IE;
 206              	        sys_safe_access_disable();
 207              	    }
 208              	}
