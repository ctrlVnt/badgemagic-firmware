 339              	 * @brief   低功耗-Shutdown模式，此低功耗切到HSI/5时钟运行，唤醒后需要用户自己重新选择系统时钟源
 340              	 *          @note 注意调用此函数，DCDC功能强制关闭，唤醒后可以手动再次打开
 341              	 *
 342              	 * @param   rm      - 供电模块选择
 343              	 *                    RB_PWR_RAM2K  -   2K retention SRAM 供电
 344              	 *                    RB_PWR_RAM16K -   16K main SRAM 供电
 345              	 *                    NULL          -   以上单元都断电
 346              	 *
 347              	 * @return  none
 348              	 */
 349              	__HIGH_CODE
 350              	void LowPower_Shutdown(uint8_t rm)
 351              	{
 352              	    uint8_t x32Kpw, x32Mpw;
 353              	
 354              	    FLASH_ROM_SW_RESET();
 355              	    x32Kpw = R8_XT32K_TUNE;
 356              	    x32Mpw = R8_XT32M_TUNE;
 357              	    x32Mpw = (x32Mpw & 0xfc) | 0x03; // 150%额定电流
 358              	    if(R16_RTC_CNT_32K > 0x3fff)
 359              	    {                                    // 超过500ms
 360              	        x32Kpw = (x32Kpw & 0xfc) | 0x01; // LSE驱动电流降低到额定电流
 361              	    }
 362              	
 363              	    sys_safe_access_enable();
 364              	    R8_BAT_DET_CTRL = 0; // 关闭电压监控
GAS LISTING /tmp/cc3W7np8.s 			page 28


 365              	    sys_safe_access_enable();
 366              	    R8_XT32K_TUNE = x32Kpw;
 367              	    R8_XT32M_TUNE = x32Mpw;
 368              	    sys_safe_access_disable();
 369              	    SetSysClock(CLK_SOURCE_HSE_6_4MHz);
 370              	
 371              	    PFIC->SCTLR |= (1 << 2); //deep sleep
 372              	
 373              	    sys_safe_access_enable();
 374              	    R8_SLP_POWER_CTRL |= RB_RAM_RET_LV;
 375              	    sys_safe_access_enable();
 376              	    R16_POWER_PLAN = RB_PWR_PLAN_EN | RB_PWR_MUST_0010 | rm;
 377              	    __WFI();
