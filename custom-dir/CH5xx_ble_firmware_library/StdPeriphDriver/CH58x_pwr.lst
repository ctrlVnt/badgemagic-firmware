 103              	/*******************************************************************************
 104              	 * @fn      PFIC_EnableIRQ
 105              	 *
 106              	 * @brief   Enable Interrupt
 107              	 *
 108              	 * @param   IRQn    - Interrupt Numbers
 109              	 */
 110              	RV_STATIC_INLINE void PFIC_EnableIRQ(IRQn_Type IRQn)
 111              	{
 112              	    PFIC->IENR[((uint32_t)(IRQn) >> 5)] = (1 << ((uint32_t)(IRQn)&0x1F));
 113              	}
 114              	
 115              	/*******************************************************************************
 116              	 * @fn      PFIC_DisableIRQ
 117              	 *
 118              	 * @brief   Disable Interrupt
 119              	 *
 120              	 * @param   IRQn    - Interrupt Numbers
 121              	 */
GAS LISTING /tmp/cc3W7np8.s 			page 12


 122              	RV_STATIC_INLINE void PFIC_DisableIRQ(IRQn_Type IRQn)
 123              	{
 124              	    PFIC->IRER[((uint32_t)(IRQn) >> 5)] = (1 << ((uint32_t)(IRQn)&0x1F));
 125              	    __nop();
 126              	    __nop();
 127              	}
