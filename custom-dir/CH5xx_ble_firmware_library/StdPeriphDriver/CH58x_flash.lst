 170              	/**
 171              	 * @brief Enter safe access mode.
 172              	 * 
 173              	 * @NOTE: After enter safe access mode, about 16 system frequency cycles 
 174              	 * are in safe mode, and one or more secure registers can be rewritten 
 175              	 * within the valid period. The safe mode will be automatically 
 176              	 * terminated after the above validity period is exceeded.
 177              	 */
 178              	 __attribute__((always_inline)) static inline void sys_safe_access_enable(void)
 179              	{
 180              	    R8_SAFE_ACCESS_SIG = SAFE_ACCESS_SIG1;
 181              	    R8_SAFE_ACCESS_SIG = SAFE_ACCESS_SIG2;
 182 0028 0100     	    SAFEOPERATE;
 183              	}
