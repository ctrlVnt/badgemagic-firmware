  30              	    RST_STATUS_GPWSM,  // 下电模式唤醒复位
  31              	    RST_STATUS_LRM1,   //	唤醒复位-看门狗引起
  32              	    RST_STATUS_LRM2,   //	唤醒复位-手动复位引起
  33              	
