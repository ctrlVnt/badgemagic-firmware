 100              	/*********************************************************************
 101              	 * @fn      GetSysClock
 102              	 *
 103              	 * @brief   获取当前系统时钟
 104              	 *
 105              	 * @param   none
 106              	 *
 107              	 * @return  Hz
 108              	 */
 109              	uint32_t GetSysClock(void)
 110              	{
 111              	    uint16_t rev;
 112              	
 113              	    rev = R16_CLK_SYS_CFG & 0xff;
 114              	    if((rev & 0x40) == (0 << 6))
 115              	    { // 32M进行分频
 116              	        return (32000000 / (rev & 0x1f));
 117              	    }
 118              	    else if((rev & RB_CLK_SYS_MOD) == (1 << 6))
 119              	    { // PLL进行分频
 120              	        return (480000000 / (rev & 0x1f));
 121              	    }
 122              	    else
 123              	    { // 32K做主频
 124              	        return (32000);
 125              	    }
 126              	}
 127              	
 128              	/*********************************************************************
 129              	 * @fn      SYS_GetInfoSta
 130              	 *
 131              	 * @brief   获取当前系统信息状态
 132              	 *
 133              	 * @param   i       - refer to SYS_InfoStaTypeDef
 134              	 *
 135              	 * @return  是否开启
 136              	 */
 137              	uint8_t SYS_GetInfoSta(SYS_InfoStaTypeDef i)
 138              	{
 139              	    if(i == STA_SAFEACC_ACT)
 140              	    {
 141              	        return (R8_SAFE_ACCESS_SIG & RB_SAFE_ACC_ACT);
 142              	    }
 143              	    else
 144              	    {
 145              	        return (R8_GLOB_CFG_INFO & (1 << i));
 146              	    }
 147              	}
 148              	
 149              	/*********************************************************************
 150              	 * @fn      SYS_ResetExecute
 151              	 *
GAS LISTING /tmp/ccVbO4bt.s 			page 15


 152              	 * @brief   执行系统软件复位
 153              	 *
 154              	 * @param   none
 155              	 *
 156              	 * @return  none
 157              	 */
 158              	__HIGH_CODE
 159              	void SYS_ResetExecute(void)
 160              	{
 161              	    FLASH_ROM_SW_RESET();
 162              	    sys_safe_access_enable();
 163              	    R8_RST_WDOG_CTRL |= RB_SOFTWARE_RESET;
 164              	    sys_safe_access_disable();
 165              	}
 166              	
 167              	/*********************************************************************
 168              	 * @fn      SYS_DisableAllIrq
 169              	 *
 170              	 * @brief   关闭所有中断，并保留当前中断值
 171              	 *
 172              	 * @param   pirqv   - 当前保留中断值
 173              	 *
 174              	 * @return  none
 175              	 */
 176              	void SYS_DisableAllIrq(uint32_t *pirqv)
 177              	{
 178              	    *pirqv = (PFIC->ISR[0] >> 8) | (PFIC->ISR[1] << 24);
 179              	    PFIC->IRER[0] = 0xffffffff;
 180              	    PFIC->IRER[1] = 0xffffffff;
 181              	}
 182              	
 183              	/*********************************************************************
 184              	 * @fn      SYS_RecoverIrq
 185              	 *
 186              	 * @brief   恢复之前关闭的中断值
 187              	 *
 188              	 * @param   irq_status  - 当前保留中断值
 189              	 *
 190              	 * @return  none
 191              	 */
 192              	void SYS_RecoverIrq(uint32_t irq_status)
 193              	{
 194              	    PFIC->IENR[0] = (irq_status << 8);
 195              	    PFIC->IENR[1] = (irq_status >> 24);
 196              	}
 197              	
 198              	/*********************************************************************
 199              	 * @fn      SYS_GetSysTickCnt
 200              	 *
 201              	 * @brief   获取当前系统(SYSTICK)计数值
 202              	 *
 203              	 * @param   none
 204              	 *
 205              	 * @return  当前计数值
 206              	 */
 207              	uint32_t SYS_GetSysTickCnt(void)
 208              	{
GAS LISTING /tmp/ccVbO4bt.s 			page 16


 209              	    uint32_t val;
 210              	
 211              	    val = SysTick->CNT;
 212              	    return (val);
 213              	}
 214              	
 215              	/*********************************************************************
 216              	 * @fn      WWDG_ITCfg
 217              	 *
 218              	 * @brief   看门狗定时器溢出中断使能
 219              	 *
 220              	 * @param   s       - 溢出是否中断
 221              	 *
 222              	 * @return  none
 223              	 */
 224              	void WWDG_ITCfg(FunctionalState s)
 225              	{
 226              	    uint8_t ctrl = R8_RST_WDOG_CTRL;
 227              	
 228              	    if(s == DISABLE)
 229              	    {
 230              	        ctrl &= ~RB_WDOG_INT_EN;
 231              	    }
 232              	    else
 233              	    {
 234              	        ctrl |= RB_WDOG_INT_EN;
 235              	    }
 236              	
 237              	    sys_safe_access_enable();
 238              	    R8_RST_WDOG_CTRL = ctrl;
 239              	    sys_safe_access_disable();
 240              	}
 241              	
 242              	/*********************************************************************
 243              	 * @fn      WWDG_ResetCfg
 244              	 *
 245              	 * @brief   看门狗定时器复位功能
 246              	 *
 247              	 * @param   s       - 溢出是否复位
 248              	 *
 249              	 * @return  none
 250              	 */
 251              	void WWDG_ResetCfg(FunctionalState s)
 252              	{
 253              	    uint8_t ctrl = R8_RST_WDOG_CTRL;
 254              	
 255              	    if(s == DISABLE)
 256              	    {
 257              	        ctrl &= ~RB_WDOG_RST_EN;
 258              	    }
 259              	    else
 260              	    {
 261              	        ctrl |= RB_WDOG_RST_EN;
 262              	    }
 263              	
 264              	    sys_safe_access_enable();
 265              	    R8_RST_WDOG_CTRL = ctrl;
GAS LISTING /tmp/ccVbO4bt.s 			page 17


 266              	    sys_safe_access_disable();
 267              	}
 268              	
 269              	/*********************************************************************
 270              	 * @fn      WWDG_ClearFlag
 271              	 *
 272              	 * @brief   清除看门狗中断标志，重新加载计数值也可清除
 273              	 *
 274              	 * @param   none
 275              	 *
 276              	 * @return  none
 277              	 */
 278              	void WWDG_ClearFlag(void)
 279              	{
 280              	    sys_safe_access_enable();
 281              	    R8_RST_WDOG_CTRL |= RB_WDOG_INT_FLAG;
 282              	    sys_safe_access_disable();
 283              	}
 284              	
 285              	/*********************************************************************
 286              	 * @fn      HardFault_Handler
 287              	 *
 288              	 * @brief   硬件错误中断，进入后执行复位，复位类型为上电复位
 289              	 *
 290              	 * @param   none
 291              	 *
 292              	 * @return  none
 293              	 */
 294              	__INTERRUPT
 295              	__HIGH_CODE
 296              	__attribute__((weak))
 297              	void HardFault_Handler(void)
 298              	{
 299              	    FLASH_ROM_SW_RESET();
 300              	    sys_safe_access_enable();
 301              	    R16_INT32K_TUNE = 0xFFFF;
 302              	    sys_safe_access_enable();
 303              	    R8_RST_WDOG_CTRL |= RB_SOFTWARE_RESET;
 304              	    sys_safe_access_disable();
 305              	    while(1);
 306              	}
