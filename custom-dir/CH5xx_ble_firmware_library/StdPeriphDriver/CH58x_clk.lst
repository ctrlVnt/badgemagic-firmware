  19              	
  20              	/**
  21              	 * @brief  rtc interrupt event define
  22              	 */
  23              	typedef enum
  24              	{
  25              	    RST_STATUS_SW = 0, // 软件复位
  26              	    RST_STATUS_RPOR,   // 上电复位
  27              	    RST_STATUS_WTR,    // 看门狗超时复位
  28              	    RST_STATUS_MR,     // 外部手动复位
  29              	    RST_STATUS_LRM0,   // 唤醒复位-软复位引起
  30              	    RST_STATUS_GPWSM,  // 下电模式唤醒复位
  31              	    RST_STATUS_LRM1,   //	唤醒复位-看门狗引起
  32              	    RST_STATUS_LRM2,   //	唤醒复位-手动复位引起
  33              	
  34              	} SYS_ResetStaTypeDef;
  35              	
  36              	/**
GAS LISTING /tmp/ccOOHGWp.s 			page 2


  37              	 * @brief  rtc interrupt event define
  38              	 */
  39              	typedef enum
  40              	{
  41              	    INFO_ROM_READ = 0, // FlashROM 代码和数据区 是否可读
  42              	    INFO_RESET_EN = 2, // RST#外部手动复位输入功能是否开启
  43              	    INFO_BOOT_EN,      // 系统引导程序 BootLoader 是否开启
  44              	    INFO_DEBUG_EN,     // 系统仿真调试接口是否开启
  45              	    INFO_LOADER,       // 当前系统是否处于Bootloader 区
  46              	    STA_SAFEACC_ACT,   // 当前系统是否处于安全访问状态，否则RWA属性区域不可访问
  47              	
  48              	} SYS_InfoStaTypeDef;
  49              	
  50              	/**
  51              	 * @brief  获取芯片ID类，一般为固定值
  52              	 */
  53              	#define SYS_GetChipID()      R8_CHIP_ID
  54              	
  55              	/**
  56              	 * @brief  获取安全访问ID，一般为固定值
  57              	 */
  58              	#define SYS_GetAccessID()    R8_SAFE_ACCESS_ID
  59              	
  60              	/**
  61              	 * @brief   配置系统运行时钟
  62              	 *
  63              	 * @param   sc      - 系统时钟源选择 refer to SYS_CLKTypeDef
  64              	 */
  65              	void SetSysClock(SYS_CLKTypeDef sc);
  66              	
  67              	/**
  68              	 * @brief   获取当前系统时钟
  69              	 *
  70              	 * @return  Hz
  71              	 */
  72              	uint32_t GetSysClock(void);
  73              	
  74              	/**
  75              	 * @brief   获取当前系统信息状态
  76              	 *
  77              	 * @param   i       - refer to SYS_InfoStaTypeDef
  78              	 *
  79              	 * @return  是否开启
  80              	 */
  81              	uint8_t SYS_GetInfoSta(SYS_InfoStaTypeDef i);
  82              	
  83              	/**
  84              	 * @brief   获取系统上次复位状态
  85              	 *
  86              	 * @return  refer to SYS_ResetStaTypeDef
  87              	 */
  88              	#define SYS_GetLastResetSta()    (R8_RESET_STATUS & RB_RESET_FLAG)
  89              	
  90              	/**
  91              	 * @brief   执行系统软件复位
  92              	 */
  93              	void SYS_ResetExecute(void);
GAS LISTING /tmp/ccOOHGWp.s 			page 3


  94              	
  95              	/**
  96              	 * @brief   设置复位保存寄存器的值，不受手动复位、 软件复位、 看门狗复位或者普通唤醒复位的影响
  97              	 *
  98              	 * @param   i       - refer to SYS_InfoStaTypeDef
  99              	 */
 100              	#define SYS_ResetKeepBuf(d)    (R8_GLOB_RESET_KEEP = d)
 101              	
 102              	/**
 103              	 * @brief   关闭所有中断，并保留当前中断值
 104              	 *
 105              	 * @param   pirqv   - 当前保留中断值
 106              	 */
 107              	void SYS_DisableAllIrq(uint32_t *pirqv);
 108              	
 109              	/**
 110              	 * @brief   恢复之前关闭的中断值
 111              	 *
 112              	 * @param   irq_status  - 当前保留中断值
 113              	 */
 114              	void SYS_RecoverIrq(uint32_t irq_status);
 115              	
 116              	/**
 117              	 * @brief   获取当前系统(SYSTICK)计数值
 118              	 *
 119              	 * @return  当前计数值
 120              	 */
 121              	uint32_t SYS_GetSysTickCnt(void);
