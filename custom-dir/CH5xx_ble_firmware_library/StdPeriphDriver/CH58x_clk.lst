 127              	 */
 128              	#define WWDG_SetCounter(c)    (R8_WDOG_COUNT = c)
 129              	
 130              	/**
 131              	 * @brief   看门狗定时器溢出中断使能
 132              	 *
 133              	 * @param   s       - 溢出是否中断
 134              	 */
 135              	void WWDG_ITCfg(FunctionalState s);
 136              	
 137              	/**
 138              	 * @brief   看门狗定时器复位功能
 139              	 *
 140              	 * @param   s       - 溢出是否复位
 141              	 */
 142              	void WWDG_ResetCfg(FunctionalState s);
 143              	
 144              	/**
 145              	 * @brief   获取当前看门狗定时器溢出标志
 146              	 *
 147              	 * @return  看门狗定时器溢出标志
 148              	 */
 149              	#define WWDG_GetFlowFlag()    (R8_RST_WDOG_CTRL & RB_WDOG_INT_FLAG)
 150              	
